
@article{keller_projection-based_2007,
	title = {A projection-based extension to phase correlation image alignment},
	volume = {87},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {01651684},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0165168406001770},
	doi = {10.1016/j.sigpro.2006.04.013},
	abstract = {Phase-correlation (PC) is a computationally efﬁcient scheme for estimating 2-D and 3-D translations. We present a masking operator that signiﬁcantly improves the accuracy and robustness of the PC scheme. The masking projects the estimated correlation function on the space of correlation functions that result from a certain range of translations, while rejecting components that are unrelated to the estimated motion. Thus, the registration accuracy is improved by an order of magnitude, especially when registering noisy images and volumes. The scheme is also shown to improve the registration of rotated images in the Fourier domain.},
	language = {en},
	number = {1},
	urldate = {2025-09-06},
	journal = {Signal Processing},
	author = {Keller, Y. and Averbuch, A.},
	month = jan,
	year = {2007},
	keywords = {Important, Reviewed},
	pages = {124--133},
	file = {PDF:/home/tekalid/Zotero/storage/ZF3BKKPP/Keller and Averbuch - 2007 - A projection-based extension to phase correlation image alignment.pdf:application/pdf},
}

@article{konstantinidis_phase_2019,
	title = {Phase {Amplified} {Correlation} for {Improved} {Sub}-{Pixel} {Motion} {Estimation}},
	volume = {28},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {1057-7149, 1941-0042},
	url = {https://ieeexplore.ieee.org/document/8624546/},
	doi = {10.1109/TIP.2019.2894266},
	abstract = {Phase correlation (PC) is widely employed by several sub-pixel motion estimation techniques in an attempt to accurately and robustly detect the displacement between two images. To achieve sub-pixel accuracy, these techniques employ interpolation methods and function-ﬁtting approaches on the cross-correlation function derived from the PC core. However, such motion estimation techniques still present a lower bound of accuracy that cannot be overcome. To allow room for further improvements, we propose, in this paper, the enhancement of the sub-pixel accuracy of motion estimation techniques by employing a completely different approach: the concept of motion magniﬁcation. To this end, we propose the novel phase ampliﬁed correlation (PAC) that integrates motion magniﬁcation between two compared images inside the PC part of the frequency-based motion estimation algorithms and thus directly substitutes the PC core. The experimentation on magnetic resonance images and real video sequences demonstrates the ability of the proposed PAC core to make subtle motions highly distinguishable and to improve the sub-pixel accuracy of the frequency-based motion estimation techniques.},
	language = {en},
	number = {6},
	urldate = {2025-09-27},
	journal = {IEEE Transactions on Image Processing},
	author = {Konstantinidis, Dimitrios and Stathaki, Tania and Argyriou, Vasileios},
	month = jun,
	year = {2019},
	keywords = {Reviewed},
	pages = {3089--3101},
	file = {PDF:/home/tekalid/Zotero/storage/K96FT8UY/Konstantinidis et al. - 2019 - Phase Amplified Correlation for Improved Sub-Pixel Motion Estimation.pdf:application/pdf},
}

@article{hoge_subspace_2003,
	title = {A subspace identification extension to the phase correlation method},
	volume = {22},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {0278-0062},
	url = {http://ieeexplore.ieee.org/document/1194637/},
	doi = {10.1109/TMI.2002.808359},
	abstract = {The phase correlation method (PCM) is known to provide straightforward estimation of rigid translational motion between two images. It is often claimed that the original method is best suited to identify integer pixel displacements, which has prompted the development of numerous subpixel displacement identification methods. However, the fact that the phase correlation matrix is rank one for a noise-free rigid translation model is often overlooked. This property leads to the low complexity subspace identification technique presented here. The combination of noninteger pixel displacement identification without interpolation, robustness to noise, and limited computational complexity make this approach a very attractive extension of the PCM. In addition, this approach is shown to be complementary with other subpixel phase correlation based techniques.},
	language = {en},
	number = {2},
	urldate = {2025-10-07},
	journal = {IEEE Transactions on Medical Imaging},
	author = {Hoge, W.S.},
	month = feb,
	year = {2003},
	keywords = {Important, Reviewed},
	pages = {277--280},
	file = {PDF:/home/tekalid/Zotero/storage/BFQLW366/Hoge - 2003 - A subspace identification extension to the phase correlation method.pdf:application/pdf},
}

@article{foroosh_extension_2002,
	title = {Extension of phase correlation to subpixel registration},
	volume = {11},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {10577149},
	url = {http://ieeexplore.ieee.org/document/988953/},
	doi = {10.1109/83.988953},
	abstract = {In this paper, we have derived analytic expressions for the phase correlation of downsampled images. We have shown that for downsampled images the signal power in the phase correlation is not concentrated in a single peak, but rather in several coherent peaks mostly adjacent to each other. These coherent peaks correspond to the polyphase transform of a filtered unit impulse centered at the point of registration. The analytic results provide a closed-form solution to subpixel translation estimation, and are used for detailed error analysis. Excellent results have been obtained for subpixel translation estimation of images of different nature and across different spectral bands.},
	language = {en},
	number = {3},
	urldate = {2025-10-07},
	journal = {IEEE Transactions on Image Processing},
	author = {Foroosh, H. and Zerubia, J.B. and Berthod, M.},
	month = mar,
	year = {2002},
	keywords = {Important, Reviewed},
	pages = {188--200},
	file = {PDF:/home/tekalid/Zotero/storage/9WXU8RAM/Foroosh et al. - 2002 - Extension of phase correlation to subpixel registration.pdf:application/pdf},
}
